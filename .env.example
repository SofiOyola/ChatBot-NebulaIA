# Copie este archivo como .env.test. Nunca use un proyecto de produccion.
# La suite no ejecuta fixtures salvo que esta marca sea exactamente "true".
NEBULA_TEST_ENV=false

SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-test-project-anon-key

# Solo para el proceso de pruebas; nunca se entrega a una aplicacion cliente.
SUPABASE_SERVICE_ROLE_KEY=replace-with-test-project-service-role-key

# Conexion directa al PostgreSQL del mismo proyecto de pruebas.
# Use sslmode=require para Supabase alojado.
TEST_DATABASE_URL=postgresql://postgres.project-ref:password@host:5432/postgres?sslmode=require

# RAG server-side only. Never expose these values to a browser, mobile client or model prompt.
RAG_DATABASE_URL=postgresql://replace-with-isolated-project-connection
# Debe identificar nebula_rag_api_login, nunca postgres, service_role ni un propietario de tablas.
RAG_EMBEDDING_PROFILE_ID=gemini-embedding-001-768
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSION=768
GEMINI_API_KEY=replace-at-runtime-only
NEBULA_RAG_TOOL_KEY=replace-with-a-long-random-server-side-secret
RAG_HTTP_HOST=127.0.0.1
RAG_HTTP_PORT=8091
